@model Caso
@{
    ViewData["Title"] = "Nuevo caso";
}

<h1 class="h3">Nuevo caso</h1>
<p class="text-body-secondary">Normalmente los casos se abren solos cuando llega el tamizaje del sistema de escritorio. Usa esta forma solo para registrar un tamizaje hecho fuera de él. El folio se genera solo y se avisa al tutor.</p>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="AlumnoId" class="form-label requerido"></label>
                    <select asp-for="AlumnoId" asp-items="ViewBag.AlumnoId" class="form-select">
                        <option value="">-- Selecciona un alumno --</option>
                    </select>
                    <span asp-validation-for="AlumnoId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label for="campanaId" class="form-label">Campaña de tamizaje</label>
                    <select id="campanaId" name="campanaId" asp-items="ViewBag.Campanas" class="form-select"><option value="">-- Sin campaña --</option></select>
                </div>
                <partial name="_Campos" model="Model" />
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-marca"><i class="bi bi-save me-1"></i>Crear caso</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
