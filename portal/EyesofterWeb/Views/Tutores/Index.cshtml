@model IEnumerable<Tutor>
@{
    ViewData["Title"] = "Tutores";
    var esAdmin = User.IsInRole(Roles.Administrador);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Tutores</h1>
        <p class="text-body-secondary mb-0">Padres, madres o tutores responsables de los alumnos.</p>
    </div>
    <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg me-1"></i>Nuevo tutor</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre, apellidos o teléfono" aria-label="Buscar" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.NombreCompleto)</th>
                    <th>@Html.DisplayNameFor(m => m.Parentesco)</th>
                    <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                    <th>@Html.DisplayNameFor(m => m.Correo)</th>
                    <th class="text-center">Alumnos</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-body-secondary py-4">No hay tutores registrados.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Parentesco</td>
                        <td>@item.Telefono</td>
                        <td>@(item.Correo ?? "—")</td>
                        <td class="text-center"><span class="badge text-bg-light">@item.Alumnos.Count</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalles"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            @if (esAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
