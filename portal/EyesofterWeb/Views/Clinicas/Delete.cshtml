@model Clinica
@{
    ViewData["Title"] = "Eliminar clínica";
}

<h1 class="h3 text-danger">Eliminar clínica</h1>
<div class="card border-danger shadow-sm">
    <div class="card-body">
        <p>¿Seguro que deseas eliminar <strong>@Model.Nombre</strong> (@Model.Direccion)?</p>
        @if (Model.Casos.Any())
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Tiene <strong>@Model.Casos.Count</strong> caso(s) canalizados. La aplicación no permitirá eliminarla.
            </div>
        }
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
