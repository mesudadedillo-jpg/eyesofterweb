@model List<Notificacion>
@{ ViewData["Title"] = "Notificaciones"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notificaciones</h1>
    @if (Model.Any(n => n.LeidaEn is null))
    {
        <form asp-action="MarcarTodas" method="post"><button class="btn btn-sm btn-outline-secondary">Marcar todas como leídas</button></form>
    }
</div>
<div class="list-group shadow-sm">
    @foreach (var n in Model)
    {
        <a asp-action="Abrir" asp-route-id="@n.Id" class="list-group-item list-group-item-action @(n.LeidaEn is null ? "fw-semibold" : "")">
            <div class="d-flex justify-content-between gap-2">
                <span>@if (n.LeidaEn is null) { <span class="badge rounded-pill bg-primary me-1">Nueva</span> }@n.Titulo</span>
                <span class="small text-body-secondary text-nowrap">@n.CreadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="small fw-normal text-body-secondary">@n.Mensaje</div>
        </a>
    }
    @if (Model.Count == 0) { <div class="list-group-item text-body-secondary">No tienes notificaciones.</div> }
</div>
