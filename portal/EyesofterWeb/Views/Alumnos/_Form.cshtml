@model Alumno
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
<div class="row g-3">
@if (ViewData["PlantelId"] is Microsoft.AspNetCore.Mvc.Rendering.SelectList escuelas)
    {
        @* Solo se pregunta la escuela si la persona tiene más de una; si no, va la suya. *@
        if (escuelas.Count() > 1)
        {
            <div class="col-md-6">
                <label asp-for="PlantelId" class="form-label requerido">Escuela</label>
                <select asp-for="PlantelId" asp-items="escuelas" class="form-select"></select>
                <span asp-validation-for="PlantelId" class="text-danger small"></span>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="PlantelId" />
            <span asp-validation-for="PlantelId" class="text-danger small"></span>
        }
    }
    <div class="col-md-4">
        <label asp-for="Matricula" class="form-label requerido"></label>
        <input asp-for="Matricula" class="form-control campo-mayusculas" placeholder="Ej. PRI2026010" />
        <span asp-validation-for="Matricula" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Nombre" class="form-label requerido"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Apellidos" class="form-label requerido"></label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FechaNacimiento" class="form-label requerido">Fecha de nacimiento</label>
        <input asp-for="FechaNacimiento" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="GrupoEscolarId" class="form-label">Grupo escolar</label>
        <select asp-for="GrupoEscolarId" asp-items="ViewBag.GrupoEscolarId" class="form-select">
            <option value="">-- Sin grupo (captura nivel, grado y letra) --</option>
        </select>
        <span asp-validation-for="GrupoEscolarId" class="text-danger small"></span>
        <div class="form-text">Con grupo, el nivel, el grado y la letra se toman del grupo y cambian solos cuando el grupo pasa de año. <a asp-controller="Grupos" asp-action="Create" target="_blank">Registrar un grupo</a></div>
    </div>
    @if (Model.Egresado || Model.Id != 0)
    {
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
                <input asp-for="Egresado" class="form-check-input" role="switch" />
                <label asp-for="Egresado" class="form-check-label">Egresado (ya no está inscrito)</label>
            </div>
        </div>
    }
    <div class="col-6 col-md-3">
        <label asp-for="Nivel" class="form-label requerido"></label>
        <select asp-for="Nivel" asp-items="Html.GetEnumSelectList<NivelEducativo>()" class="form-select"></select>
        <span asp-validation-for="Nivel" class="text-danger small"></span>
    </div>
    <div class="col-3 col-md-2">
        <label asp-for="Grado" class="form-label requerido"></label>
        <input asp-for="Grado" class="form-control" min="1" max="6" />
        <span asp-validation-for="Grado" class="text-danger small"></span>
    </div>
    <div class="col-3 col-md-3">
        <label asp-for="Grupo" class="form-label requerido"></label>
        <select asp-for="Grupo" class="form-select">
            <option>A</option><option>B</option><option>C</option><option>D</option><option>E</option><option>F</option>
        </select>
        <span asp-validation-for="Grupo" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="TutorId" class="form-label requerido"></label>
        <select asp-for="TutorId" asp-items="ViewBag.TutorId" class="form-select">
            <option value="">-- Selecciona un tutor --</option>
        </select>
        <span asp-validation-for="TutorId" class="text-danger small"></span>
        <div class="form-text">¿No aparece? <a asp-controller="Tutores" asp-action="Create" target="_blank">Registra al tutor</a> y recarga.</div>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="UsaLentes" class="form-check-input" role="switch" />
            <label asp-for="UsaLentes" class="form-check-label"></label>
        </div>
    </div>
</div>
