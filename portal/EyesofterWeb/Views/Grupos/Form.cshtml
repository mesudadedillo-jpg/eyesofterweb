@model GrupoEscolar
@{
    var nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo grupo" : $"Editar grupo {Model.Nombre}";
}
<h1 class="h3">@(nuevo ? "Nuevo grupo" : "Editar grupo")</h1>
@if (!nuevo)
{
    <p class="text-body-secondary">Si cambias el nivel, el grado o la letra, todos los alumnos del grupo se actualizan con él.</p>
}
<form asp-action="@(nuevo ? "Create" : "Edit")" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        @if (ViewData["PlantelId"] is Microsoft.AspNetCore.Mvc.Rendering.SelectList escuelas)
        {
            if (escuelas.Count() > 1)
            {
                <div class="col-md-6">
                    <label asp-for="PlantelId" class="form-label requerido">Escuela</label>
                    <select asp-for="PlantelId" asp-items="escuelas" class="form-select"></select>
                    <span asp-validation-for="PlantelId" class="text-danger small"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="PlantelId" />
                <span asp-validation-for="PlantelId" class="text-danger small"></span>
            }
        }
        <div class="col-6 col-md-3">
            <label asp-for="Nivel" class="form-label requerido"></label>
            <select asp-for="Nivel" asp-items="Html.GetEnumSelectList<NivelEducativo>()" class="form-select"></select>
            <span asp-validation-for="Nivel" class="text-danger small"></span>
        </div>
        <div class="col-3 col-md-2">
            <label asp-for="Grado" class="form-label requerido"></label>
            <input asp-for="Grado" class="form-control" min="1" max="6" />
            <span asp-validation-for="Grado" class="text-danger small"></span>
        </div>
        <div class="col-3 col-md-2">
            <label asp-for="Letra" class="form-label requerido"></label>
            <select asp-for="Letra" class="form-select">
                <option>A</option><option>B</option><option>C</option><option>D</option><option>E</option><option>F</option>
            </select>
            <span asp-validation-for="Letra" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CicloEscolar" class="form-label requerido"></label>
            <input asp-for="CicloEscolar" class="form-control" placeholder="2026-2027" />
            <span asp-validation-for="CicloEscolar" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Docente" class="form-label"></label>
            <input asp-for="Docente" class="form-control" placeholder="Opcional" />
            <span asp-validation-for="Docente" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-marca"><i class="bi bi-save me-1" aria-hidden="true"></i>Guardar</button>
        <a asp-action="@(nuevo ? "Index" : "Details")" asp-route-id="@(nuevo ? null : Model.Id)" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
