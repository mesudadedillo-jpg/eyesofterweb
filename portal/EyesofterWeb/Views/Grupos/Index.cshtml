@model List<EyesofterWeb.Controllers.GruposController.FilaGrupo>
@{
    ViewData["Title"] = "Grupos";
    var esAdmin = User.IsInRole(Roles.Administrador);
    var escuelas = (List<Plantel>)ViewBag.Escuelas;
    var plantelId = (int)ViewBag.PlantelId;
    var historial = (bool)ViewBag.Historial;
    var sinGrupo = (int)ViewBag.SinGrupo;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Grupos</h1>
        <p class="text-body-secondary mb-0">Registra cada grupo e inscribe a sus alumnos. Al terminar el ciclo, el grupo pasa de año con todos sus alumnos.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (esAdmin && !historial)
        {
            <a asp-action="PasarDeAnio" asp-route-plantelId="@plantelId" class="btn btn-outline-primary"><i class="bi bi-arrow-up-circle me-1" aria-hidden="true"></i>Pasar de año a toda la escuela</a>
        }
        <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nuevo grupo</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3 align-items-center">
    @if (escuelas.Count > 1)
    {
        <div class="col-sm-6 col-md-4">
            <select name="plantelId" class="form-select" aria-label="Escuela" data-auto-enviar>
                @foreach (var e in escuelas)
                {
                    <option value="@e.Id" selected="@(e.Id == plantelId)">@e.Nombre</option>
                }
            </select>
        </div>
    }
    else
    {
        <input type="hidden" name="plantelId" value="@plantelId" />
    }
    <div class="col-auto">
        <div class="btn-group" role="group" aria-label="Ver">
            <a asp-route-plantelId="@plantelId" asp-route-historial="false" class="btn btn-sm @(historial ? "btn-outline-secondary" : "btn-secondary")">Activos</a>
            <a asp-route-plantelId="@plantelId" asp-route-historial="true" class="btn btn-sm @(historial ? "btn-secondary" : "btn-outline-secondary")">Egresados</a>
        </div>
    </div>
</form>

@if (!historial && sinGrupo > 0)
{
    <div class="alert alert-info py-2" role="status">
        <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
        Hay <strong>@sinGrupo</strong> alumno(s) sin grupo. Abre un grupo y usa <em>Inscribir alumnos</em> para agregarlos.
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Grupo</th>
                    <th scope="col">Ciclo escolar</th>
                    <th scope="col">Docente titular</th>
                    <th scope="col" class="text-end">Alumnos</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-body-secondary py-4">@(historial ? "Todavía no hay grupos egresados." : "Registra el primer grupo de la escuela.")</td></tr>
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@f.Grupo.Id" class="fw-semibold">@f.Grupo.Nombre</a></td>
                        <td>@f.Grupo.CicloEscolar</td>
                        <td>@(f.Grupo.Docente ?? "—")</td>
                        <td class="text-end">@f.Alumnos</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@f.Grupo.Id" class="btn btn-sm btn-outline-secondary" title="Ver alumnos"><i class="bi bi-people" aria-hidden="true"></i><span class="visually-hidden">Ver alumnos</span></a>
                            @if (f.Grupo.Activo)
                            {
                                <a asp-action="Edit" asp-route-id="@f.Grupo.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil" aria-hidden="true"></i><span class="visually-hidden">Editar</span></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
