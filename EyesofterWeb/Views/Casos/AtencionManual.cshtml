@model AtencionManualViewModel
@{ ViewData["Title"] = "Registrar atención"; }
<h1 class="h3">Registrar atención</h1>
<p class="text-body-secondary">Caso <code>@Model.Folio</code> · @Model.Alumno. Para alumnos atendidos en una clínica no asociada, a partir del comprobante validado.</p>
<form asp-action="AtencionManual" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input type="hidden" asp-for="CasoId" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ComprobanteId" class="form-label requerido"></label>
            <select asp-for="ComprobanteId" asp-items="ViewBag.Comprobantes" class="form-select"></select>
            <span asp-validation-for="ComprobanteId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Fecha" class="form-label requerido"></label>
            <input asp-for="Fecha" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ClinicaId" class="form-label"></label>
            <select asp-for="ClinicaId" asp-items="ViewBag.ClinicaId" class="form-select"><option value="">-- No está en el directorio --</option></select>
        </div>
        <div class="col-md-6">
            <label asp-for="ClinicaNombre" class="form-label"></label>
            <input asp-for="ClinicaNombre" class="form-control" />
            <span asp-validation-for="ClinicaNombre" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Valoracion" class="form-label requerido"></label>
            <textarea asp-for="Valoracion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Valoracion" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Indicaciones" class="form-label"></label>
            <textarea asp-for="Indicaciones" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-12 form-check ms-2">
            <input asp-for="CorreccionOptica" class="form-check-input" />
            <label asp-for="CorreccionOptica" class="form-check-label"></label>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-marca">Registrar atención</button>
        <a asp-action="Details" asp-route-id="@Model.CasoId" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
