@model IEnumerable<Caso>
@{
    ViewData["Title"] = "Casos";
    var esAdmin = User.IsInRole(Roles.Administrador);
    var puedeEditar = esAdmin || User.IsInRole(Roles.Enfermeria);
    var estadoSel = ViewBag.Estado as EstadoCaso?;
    var semaforoSel = ViewBag.Semaforo as Semaforo?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Casos</h1>
        <p class="text-body-secondary mb-0">Expedientes de seguimiento visual.</p>
    </div>
    @if (puedeEditar)
    {
        <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg me-1"></i>Nuevo caso</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Folio o nombre del alumno" aria-label="Buscar" />
    </div>
    <div class="col-6 col-md-3">
        <select name="estado" class="form-select" aria-label="Estado">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoCaso>())
            {
                <option value="@e" selected="@(estadoSel == e)">@e.Texto()</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <select name="semaforo" class="form-select" aria-label="Semáforo">
            <option value="">Todos los semáforos</option>
            @foreach (var s in Enum.GetValues<Semaforo>())
            {
                <option value="@s" selected="@(semaforoSel == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i> Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Folio</th>
                    <th>Alumno</th>
                    <th>Semáforo</th>
                    <th>Estado</th>
                    <th>Clínica</th>
                    <th>Detección</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">No se encontraron casos.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="folio"><code>@item.Folio</code></td>
                        <td>@item.Alumno?.NombreCompleto</td>
                        <td><partial name="_Semaforo" model="item.Semaforo" /></td>
                        <td><partial name="_Estado" model="item.Estado" /></td>
                        <td>@(item.Clinica?.Nombre ?? "Sin canalizar")</td>
                        <td>@item.FechaDeteccion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalles"><i class="bi bi-eye"></i></a>
                            @if (puedeEditar && item.Estado != EstadoCaso.Cerrado)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            }
                            @if (esAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
