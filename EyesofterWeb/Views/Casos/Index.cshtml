@model List<Caso>
@{
    ViewData["Title"] = "Casos";
    var esAdmin = User.IsInRole(Roles.Administrador);
    var f = (FiltroCasos)ViewBag.Filtro;
    var campanas = (List<Campana>)ViewBag.Campanas;
    var consulta = Context.Request.QueryString.Value ?? "";
    string ConFormato(string formato) => (string.IsNullOrEmpty(consulta) ? "?" : consulta + "&") + "formato=" + formato;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Casos</h1>
        <p class="text-body-secondary mb-0">Expedientes de seguimiento visual. Los del sistema de escritorio se abren solos.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Url.Action("Index")@ConFormato("pdf")" class="btn btn-outline-secondary"><i class="bi bi-filetype-pdf me-1" aria-hidden="true"></i>PDF</a>
        <a href="@Url.Action("Index")@ConFormato("excel")" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-excel me-1" aria-hidden="true"></i>Excel</a>
        <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nuevo caso</a>
    </div>
</div>

<ul class="nav nav-pills mb-3" aria-label="Vista rápida">
    <li class="nav-item"><a class="nav-link @(f.Vista == "abiertos" ? "active" : "")" asp-action="Index" asp-route-vista="abiertos">Abiertos <span class="badge text-bg-light">@ViewBag.Abiertos</span></a></li>
    <li class="nav-item"><a class="nav-link @(f.Vista == "resueltos" ? "active" : "")" asp-action="Index" asp-route-vista="resueltos">Resueltos <span class="badge text-bg-light">@ViewBag.Resueltos</span></a></li>
    <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(f.Vista) ? "active" : "")" asp-action="Index">Todos</a></li>
</ul>

<form method="get" class="row g-2 mb-3 align-items-end" aria-label="Filtros">
    <input type="hidden" name="vista" value="@f.Vista" />
    <div class="col-12 col-md-3">
        <label for="buscar" class="form-label small mb-1">Buscar</label>
        <input id="buscar" name="buscar" value="@f.Buscar" class="form-control" placeholder="Folio, nombre o matrícula" />
    </div>
    <div class="col-6 col-md-2">
        <label for="nivel" class="form-label small mb-1">Nivel</label>
        <select id="nivel" name="nivel" class="form-select">
            <option value="">Todos</option>
            @foreach (var n in Enum.GetValues<NivelEducativo>()) { <option value="@n" selected="@(f.Nivel == n)">@n</option> }
        </select>
    </div>
    <div class="col-3 col-md-1">
        <label for="grado" class="form-label small mb-1">Grado</label>
        <select id="grado" name="grado" class="form-select">
            <option value="">—</option>
            @for (var g = 1; g <= 6; g++) { <option value="@g" selected="@(f.Grado == g)">@g°</option> }
        </select>
    </div>
    <div class="col-3 col-md-1">
        <label for="grupo" class="form-label small mb-1">Grupo</label>
        <select id="grupo" name="grupo" class="form-select">
            <option value="">—</option>
            @foreach (var g in "ABCDEF") { <option value="@g" selected="@(f.Grupo == g.ToString())">@g</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="estado" class="form-label small mb-1">Estado</label>
        <select id="estado" name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var e in Enum.GetValues<EstadoCaso>()) { <option value="@e" selected="@(f.Estado == e)">@e.Texto()</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="semaforo" class="form-label small mb-1">Semáforo</label>
        <select id="semaforo" name="semaforo" class="form-select">
            <option value="">Todos</option>
            @foreach (var s in Enum.GetValues<Semaforo>()) { <option value="@s" selected="@(f.Semaforo == s)">@s</option> }
        </select>
    </div>
    @if (campanas.Count > 0)
    {
        <div class="col-12 col-md-3">
            <label for="campanaId" class="form-label small mb-1">Campaña</label>
            <select id="campanaId" name="campanaId" class="form-select">
                <option value="">Todas</option>
                @foreach (var c in campanas) { <option value="@c.Id" selected="@(f.CampanaId == c.Id)">@c.Nombre (@c.CicloEscolar)</option> }
            </select>
        </div>
    }
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">@f.Descripcion()</caption>
            <thead class="table-light">
                <tr><th scope="col">Folio</th><th scope="col">Alumno</th><th scope="col">Grado</th><th scope="col">Semáforo</th><th scope="col">Estado</th><th scope="col">Clínica</th><th scope="col">Detección</th><th scope="col" class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-body-secondary py-4">No se encontraron casos.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="folio"><a asp-action="Details" asp-route-id="@item.Id"><code>@item.Folio</code></a></td>
                        <td>@item.Alumno?.NombreCompleto</td>
                        <td class="text-nowrap">@item.Alumno?.Grado° @item.Alumno?.Grupo <span class="small text-body-secondary">@item.Alumno?.Nivel</span></td>
                        <td><partial name="_Semaforo" model="item.Semaforo" /></td>
                        <td><partial name="_Estado" model="item.Estado" /></td>
                        <td>@(item.Clinica?.Nombre ?? item.ClinicaDestinoManual ?? "Sin canalizar")</td>
                        <td>@item.FechaDeteccion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" aria-label="Ver expediente @item.Folio"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            @if (item.Estado != EstadoCaso.Cerrado)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="Actualizar @item.Folio"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            }
                            @if (esAdmin)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" aria-label="Eliminar @item.Folio"><i class="bi bi-trash" aria-hidden="true"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
