@model List<Campana>
@{ ViewData["Title"] = "Campañas de tamizaje"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-0">Campañas de tamizaje</h1><p class="text-body-secondary mb-0">Los tamizajes que llegan del escritorio se asignan a la campaña vigente en su fecha.</p></div>
    <a asp-action="Create" class="btn btn-marca"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nueva campaña</a>
</div>
<div class="table-responsive card shadow-sm">
    <table class="table align-middle mb-0">
        <thead class="table-light"><tr><th scope="col">Campaña</th><th scope="col">Escuela</th><th scope="col">Ciclo</th><th scope="col">Periodo</th><th scope="col" class="text-end">Tamizajes</th><th scope="col"></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr><td>@c.Nombre</td><td>@c.Plantel?.Nombre</td><td>@c.CicloEscolar</td><td>@c.FechaInicio.ToString("dd/MM/yyyy") – @(c.FechaFin?.ToString("dd/MM/yyyy") ?? "vigente")</td><td class="text-end">@c.Tamizajes.Count</td>
                    <td class="text-end"><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-controller="Home" asp-action="Index" asp-route-campanaId="@c.Id" class="btn btn-sm btn-outline-secondary">Indicadores</a></td></tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-body-secondary py-4">Crea la primera campaña del ciclo escolar.</td></tr> }
        </tbody>
    </table>
</div>
