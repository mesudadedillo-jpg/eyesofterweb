@model Campana
@{ ViewData["Title"] = Model.Id == 0 ? "Nueva campaña" : "Editar campaña"; }
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Nombre" class="form-label requerido"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="CicloEscolar" class="form-label requerido"></label><input asp-for="CicloEscolar" class="form-control" /><span asp-validation-for="CicloEscolar" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="FechaInicio" class="form-label requerido"></label><input asp-for="FechaInicio" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" /><span asp-validation-for="FechaFin" class="text-danger small"></span></div>
    </div>
    <div class="d-flex gap-2 mt-3"><button class="btn btn-marca">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
