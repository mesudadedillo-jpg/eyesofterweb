@{ ViewData["Title"] = "Base de datos no disponible"; }
<div class="alert alert-danger">
    <h1 class="h5"><i class="bi bi-database-exclamation me-1" aria-hidden="true"></i>La base de datos no está lista</h1>
    <p class="mb-0">Revisa la variable <code>DATABASE_URL</code> (o <code>ConnectionStrings:DefaultConnection</code> en local) y que PostgreSQL esté encendido. Las migraciones se aplican solas al arrancar.</p>
</div>
