@{
    ViewData["Title"] = "Permisos por rol";
    var filas = new (string Accion, bool Dir, bool Enf, bool Tut, bool Esp, bool Alu)[]
    {
        ("Dashboard e indicadores, exportar PDF y Excel", true, true, false, false, false),
        ("Ver y gestionar expedientes y su línea de tiempo", true, true, false, false, false),
        ("Cerrar un caso (con corrección óptica comprobada)", true, true, false, false, false),
        ("Reabrir o eliminar un caso", true, false, false, false, false),
        ("Registrar tutores y alumnos; vincular tutor con alumnos", true, true, false, false, false),
        ("Validar o rechazar comprobantes", true, true, false, false, false),
        ("Registrar atención manual (clínica no asociada)", true, true, false, false, false),
        ("Alta, edición y desactivación de clínicas", true, true, false, false, false),
        ("Enviar avisos y ver quién los leyó", true, true, false, false, false),
        ("Crear cuentas, asignar roles, ver la bitácora", true, false, false, false, false),
        ("Ver el reporte de SUS hijos, el pase o el resumen", false, false, true, false, false),
        ("Elegir clínica de destino y subir comprobante", false, false, true, false, false),
        ("Escanear el pase con QR y registrar la atención", false, false, false, true, false),
        ("Consejos para cuidar la vista", false, false, false, false, true),
    };
}
<h1 class="h3 mb-3">Permisos por rol</h1>
<p class="text-body-secondary">Las restricciones se aplican en el servidor (no solo ocultando botones). Un tutor solo puede consultar a los alumnos a su cargo (C-RC-06).</p>
<div class="table-responsive" tabindex="0" role="region" aria-label="Tabla de permisos por rol">
    <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
            <tr><th scope="col" class="text-start">Acción</th><th scope="col">Dirección</th><th scope="col">Enfermería</th><th scope="col">Tutor</th><th scope="col">Especialista</th><th scope="col">Alumno</th></tr>
        </thead>
        <tbody>
            @foreach (var f in filas)
            {
                <tr>
                    <th scope="row" class="text-start fw-normal">@f.Accion</th>
                    @foreach (var p in new[] { f.Dir, f.Enf, f.Tut, f.Esp, f.Alu })
                    {
                        <td>@if (p) {<i class="bi bi-check-lg text-success" role="img" aria-label="Sí"></i>} else {<i class="bi bi-dash text-body-tertiary" role="img" aria-label="No"></i>}</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
