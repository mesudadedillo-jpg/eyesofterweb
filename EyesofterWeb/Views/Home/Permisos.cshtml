@{
    ViewData["Title"] = "Permisos por rol";
    string Si() => "si";
    var filas = new (string Funcion, string Ruta, string Admin, string Enf, string Doc)[]
    {
        ("Consultar casos, alumnos y clínicas", "/Casos, /Alumnos, /Clinicas", "si", "si", "si"),
        ("Crear y editar casos", "/Casos/Create, /Casos/Edit/{id}", "si", "si", "no"),
        ("Agregar eventos de seguimiento", "/Eventos/Create?casoId={id}", "si", "si", "no"),
        ("Cerrar un caso", "/Casos/Cerrar/{id}", "si", "si", "no"),
        ("Crear y editar alumnos", "/Alumnos/Create, /Alumnos/Edit/{id}", "si", "si", "no"),
        ("Ver y administrar tutores (datos de contacto)", "/Tutores", "si", "si", "no"),
        ("Crear, editar y eliminar clínicas", "/Clinicas/Create, /Clinicas/Edit/{id}", "si", "no", "no"),
        ("Eliminar alumnos, tutores y casos", "/…/Delete/{id}", "si", "no", "no"),
        ("Editar o eliminar eventos; reabrir casos", "/Eventos/Edit/{id}, /Casos/Reabrir/{id}", "si", "no", "no"),
        ("Administrar usuarios y asignar roles", "/Usuarios", "si", "no", "no"),
    };
}

<h1 class="h3">Permisos por rol</h1>
<p class="text-body-secondary">
    Las restricciones se aplican en el servidor con <code>[Authorize(Roles = "...")]</code> en cada controlador o acción.
    Ocultar botones es solo una ayuda visual: si un usuario escribe la ruta a mano, la aplicación lo manda a
    <strong>Acceso denegado</strong> (HTTP 403).
</p>

<div class="alert alert-info">
    <i class="bi bi-person-badge me-1"></i>
    Sesión actual: <strong>@User.Identity?.Name</strong> ·
    Roles:
    @foreach (var rol in Roles.Todos.Where(r => User.IsInRole(r)))
    {
        <span class="badge text-bg-primary">@rol</span>
    }
</div>

<div class="table-responsive">
    <table class="table table-bordered align-middle bg-body">
        <thead class="table-light">
            <tr>
                <th>Funcionalidad</th>
                <th>Ruta para probar</th>
                <th class="text-center">Administrador</th>
                <th class="text-center">Enfermería</th>
                <th class="text-center">Docente</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in filas)
            {
                <tr>
                    <td>@f.Funcion</td>
                    <td><code>@f.Ruta</code></td>
                    @foreach (var v in new[] { f.Admin, f.Enf, f.Doc })
                    {
                        <td class="text-center">
                            @if (v == Si())
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Permitido</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Denegado</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5 mt-4">Prueba rápida de acceso denegado</h2>
<p>Con la cuenta <code>docente@@eyesofter.mx</code>, abre estas direcciones directamente en el navegador:</p>
<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-danger btn-sm" href="/Tutores">/Tutores</a>
    <a class="btn btn-outline-danger btn-sm" href="/Casos/Create">/Casos/Create</a>
    <a class="btn btn-outline-danger btn-sm" href="/Clinicas/Create">/Clinicas/Create</a>
    <a class="btn btn-outline-danger btn-sm" href="/Usuarios">/Usuarios</a>
</div>
