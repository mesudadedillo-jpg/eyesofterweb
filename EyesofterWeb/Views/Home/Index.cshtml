@model TableroViewModel
@{
    ViewData["Title"] = "Tablero";
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Enfermeria);
}

@if (!Model.BaseDeDatosLista)
{
    <div class="alert alert-warning">
        <h2 class="h5"><i class="bi bi-database-exclamation me-1"></i>La base de datos no está lista</h2>
        <p class="mb-1">Ejecuta en la carpeta del proyecto:</p>
        <pre class="mb-0"><code>dotnet ef migrations add Inicial
dotnet ef database update</code></pre>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Tablero</h1>
        <p class="text-body-secondary mb-0">Resumen del seguimiento visual escolar</p>
    </div>
    @if (puedeEditar)
    {
        <a class="btn btn-marca" asp-controller="Casos" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Nuevo caso</a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card tarjeta-dato shadow-sm h-100"><div class="card-body">
            <div class="numero">@Model.CasosAbiertos</div><div class="text-body-secondary">Casos activos</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tarjeta-dato shadow-sm h-100" style="border-left-color:#b42318"><div class="card-body">
            <div class="numero text-danger">@Model.CasosRojos</div><div class="text-body-secondary">Activos en rojo</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tarjeta-dato shadow-sm h-100"><div class="card-body">
            <div class="numero">@Model.Alumnos</div><div class="text-body-secondary">Alumnos</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card tarjeta-dato shadow-sm h-100"><div class="card-body">
            <div class="numero">@Model.Clinicas</div><div class="text-body-secondary">Clínicas</div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-body d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0">Casos más recientes</h2>
        <a asp-controller="Casos" asp-action="Index" class="small">Ver todos</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Folio</th><th>Alumno</th><th>Semáforo</th><th>Estado</th><th>Detección</th></tr>
            </thead>
            <tbody>
                @if (!Model.UltimosCasos.Any())
                {
                    <tr><td colspan="5" class="text-center text-body-secondary py-4">Todavía no hay casos.</td></tr>
                }
                @foreach (var c in Model.UltimosCasos)
                {
                    <tr>
                        <td><a asp-controller="Casos" asp-action="Details" asp-route-id="@c.Id">@c.Folio</a></td>
                        <td>@c.Alumno?.NombreCompleto</td>
                        <td><partial name="_Semaforo" model="c.Semaforo" /></td>
                        <td><partial name="_Estado" model="c.Estado" /></td>
                        <td>@c.FechaDeteccion.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
