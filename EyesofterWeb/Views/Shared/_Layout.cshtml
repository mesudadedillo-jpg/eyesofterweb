<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EYESOFTER Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var esAdmin = User.IsInRole(Roles.Administrador);
        var esEnfermeria = User.IsInRole(Roles.Enfermeria);
        var rolActual = esAdmin ? Roles.Administrador : esEnfermeria ? "Enfermería" : User.IsInRole(Roles.Docente) ? Roles.Docente : "Sin rol";
    }
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-marca shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-eye-fill me-1" aria-hidden="true"></i> EYESOFTER <span class="fw-light">Web</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                            <li class="nav-item"><a class="nav-link" asp-controller="Casos" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1"></i>Casos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Alumnos" asp-action="Index"><i class="bi bi-mortarboard me-1"></i>Alumnos</a></li>
                            @if (esAdmin || esEnfermeria)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Tutores" asp-action="Index"><i class="bi bi-people me-1"></i>Tutores</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Clinicas" asp-action="Index"><i class="bi bi-hospital me-1"></i>Clínicas</a></li>
                            @if (esAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Usuarios</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Permisos"><i class="bi bi-diagram-3 me-1"></i>Permisos</a></li>
                        </ul>
                        <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-2">
                            <span class="navbar-text small">
                                <i class="bi bi-person-circle me-1"></i><span class="d-xl-none d-xxl-inline">@User.Identity?.Name</span>
                                <span class="badge text-bg-light ms-1">@rolActual</span>
                            </span>
                            <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm text-nowrap"><i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro"><i class="bi bi-person-plus me-1"></i>Registrarse</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4" role="main">
        <partial name="_Alertas" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 bg-body-tertiary">
        <div class="container small text-body-secondary d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Today.Year EYESOFTER Suite · Módulo web de seguimiento de casos</span>
            <span>ASP.NET Core MVC · EF Core · SQL Server · Identity</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
