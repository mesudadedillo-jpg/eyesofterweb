@inject Microsoft.Extensions.Options.IOptions<EyesofterWeb.Servicios.OpcionesEyesofter> Opciones
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole(Roles.Administrador);
    var esPersonal = esAdmin || User.IsInRole(Roles.Enfermeria);
    var esTutor = User.IsInRole(Roles.Tutor);
    var esEspecialista = User.IsInRole(Roles.Especialista);
    var esAlumno = User.IsInRole(Roles.Alumno);
    var rolActual = Roles.Todos.Where(r => User.IsInRole(r)).Select(Roles.NombreVisible).FirstOrDefault() ?? "Sin rol";
    string Activo(string controlador) => string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controlador, StringComparison.OrdinalIgnoreCase) ? " active" : "";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EYESOFTER Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" data-inactividad="@(autenticado ? Opciones.Value.MinutosInactividad : 0)">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-marca shadow-sm" aria-label="Menú principal">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-eye-fill me-1" aria-hidden="true"></i> EYESOFTER <span class="fw-light">Web</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    @if (autenticado)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                            @if (esPersonal)
                            {
                                <li class="nav-item"><a class="nav-link@(Activo("Casos"))" asp-controller="Casos" asp-action="Index"><i class="bi bi-clipboard2-pulse me-1" aria-hidden="true"></i>Casos</a></li>
                                <li class="nav-item"><a class="nav-link@(Activo("Alumnos"))" asp-controller="Alumnos" asp-action="Index"><i class="bi bi-mortarboard me-1" aria-hidden="true"></i>Alumnos</a></li>
                                <li class="nav-item"><a class="nav-link@(Activo("Tutores"))" asp-controller="Tutores" asp-action="Index"><i class="bi bi-people me-1" aria-hidden="true"></i>Tutores</a></li>
                                <li class="nav-item"><a class="nav-link@(Activo("Comprobantes"))" asp-controller="Comprobantes" asp-action="Index"><i class="bi bi-file-earmark-check me-1" aria-hidden="true"></i>Comprobantes</a></li>
                                <li class="nav-item"><a class="nav-link@(Activo("Clinicas"))" asp-controller="Clinicas" asp-action="Index"><i class="bi bi-hospital me-1" aria-hidden="true"></i>Clínicas</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-three-dots me-1" aria-hidden="true"></i>Más</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Avisos" asp-action="Index"><i class="bi bi-megaphone me-1" aria-hidden="true"></i>Avisos y seguimiento de lectura</a></li>
                                        <li><a class="dropdown-item" asp-controller="Campanas" asp-action="Index"><i class="bi bi-calendar-range me-1" aria-hidden="true"></i>Campañas de tamizaje</a></li>
                                        @if (esAdmin)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Usuarios</a></li>
                                            <li><a class="dropdown-item" asp-controller="Auditoria" asp-action="Index"><i class="bi bi-journal-text me-1" aria-hidden="true"></i>Bitácora de auditoría</a></li>
                                            <li><a class="dropdown-item" asp-controller="Soporte" asp-action="Reportes"><i class="bi bi-bug me-1" aria-hidden="true"></i>Reportes de fallas</a></li>
                                        }
                                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Permisos"><i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>Permisos por rol</a></li>
                                    </ul>
                                </li>
                            }
                            @if (esTutor)
                            {
                                <li class="nav-item"><a class="nav-link@(Activo("MisHijos"))" asp-controller="MisHijos" asp-action="Index"><i class="bi bi-person-hearts me-1" aria-hidden="true"></i>Mis hijos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="MisHijos" asp-action="Directorio"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>Clínicas</a></li>
                            }
                            @if (esEspecialista)
                            {
                                <li class="nav-item"><a class="nav-link@(Activo("Pases"))" asp-controller="Pases" asp-action="Escanear"><i class="bi bi-qr-code-scan me-1" aria-hidden="true"></i>Leer pase médico</a></li>
                            }
                            @if (esAlumno)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-eye me-1" aria-hidden="true"></i>Cuida tu vista</a></li>
                            }
                        </ul>
                        <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-2">
                            <a class="btn btn-outline-light btn-sm position-relative" asp-controller="Notificaciones" asp-action="Index" aria-label="Notificaciones">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                                @await Component.InvokeAsync("ContadorNotificaciones")
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-outline-light btn-sm dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1" aria-hidden="true"></i><span class="d-xl-none d-xxl-inline">@User.Identity?.Name</span>
                                    <span class="badge text-bg-light ms-1">@rolActual</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarPassword"><i class="bi bi-key me-1" aria-hidden="true"></i>Cambiar contraseña</a></li>
                                    <li><a class="dropdown-item" asp-controller="Soporte" asp-action="Reportar"><i class="bi bi-life-preserver me-1" aria-hidden="true"></i>Reportar una falla o duda</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Iniciar sesión</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido" class="container flex-grow-1 py-4" role="main" tabindex="-1">
        <partial name="_Alertas" />
        @RenderBody()
    </main>

    @if (autenticado)
    {
        <div id="avisoInactividad" class="aviso-inactividad alert alert-warning shadow d-none" role="alertdialog" aria-live="assertive" aria-labelledby="textoInactividad">
            <p id="textoInactividad" class="mb-2"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Tu sesión se cerrará en 1 minuto por inactividad.</p>
            <button type="button" class="btn btn-sm btn-marca" id="seguirConectado">Seguir conectado</button>
        </div>
    }

    <footer class="border-top py-3 bg-body-tertiary">
        <div class="container small text-body-secondary d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Today.Year EYESOFTER Suite · Escuela Primaria-Secundaria METANOIA</span>
            <nav aria-label="Enlaces legales" class="d-flex flex-wrap gap-3">
                <a class="link-secondary" asp-controller="Privacidad" asp-action="Aviso">Aviso de privacidad</a>
                <a class="link-secondary" asp-controller="Privacidad" asp-action="Terminos">Términos de uso</a>
                <a class="link-secondary" asp-controller="Soporte" asp-action="Ayuda">Ayuda</a>
                <a class="link-secondary" asp-controller="Soporte" asp-action="Reportar">Reportar una falla</a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
