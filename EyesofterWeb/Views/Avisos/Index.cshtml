@model EyesofterWeb.Controllers.AvisosController.AvisoForm
@{ ViewData["Title"] = "Enviar aviso"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Avisar a las familias</h1>
    <a asp-action="Seguimiento" class="btn btn-outline-secondary">Seguimiento de lectura</a>
</div>
<form asp-action="Index" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <fieldset class="mb-3">
        <legend class="form-label">Para</legend>
        <div class="form-check"><input class="form-check-input" type="radio" asp-for="Para" value="tutores" id="paraTodos" /><label class="form-check-label" for="paraTodos">Todos los tutores</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" asp-for="Para" value="grupo" id="paraGrupo" /><label class="form-check-label" for="paraGrupo">Tutores de un grado y grupo</label></div>
    </fieldset>
    <div class="row g-2 mb-3">
        <div class="col-md-4"><label asp-for="Nivel" class="form-label small"></label><select asp-for="Nivel" asp-items="Html.GetEnumSelectList<NivelEducativo>()" class="form-select"><option value="">—</option></select></div>
        <div class="col-md-4"><label asp-for="Grado" class="form-label small"></label><input asp-for="Grado" type="number" min="1" max="6" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Grupo" class="form-label small"></label><input asp-for="Grupo" maxlength="1" class="form-control campo-mayusculas" /></div>
    </div>
    <div class="mb-3"><label asp-for="Titulo" class="form-label requerido"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Mensaje" class="form-label requerido"></label><textarea asp-for="Mensaje" class="form-control" rows="4"></textarea><span asp-validation-for="Mensaje" class="text-danger small"></span></div>
    <button type="submit" class="btn btn-marca"><i class="bi bi-send me-1" aria-hidden="true"></i>Enviar aviso</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
