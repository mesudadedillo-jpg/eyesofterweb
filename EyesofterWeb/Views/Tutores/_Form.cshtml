@model Tutor
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
<div class="row g-3">
@if (ViewData["PlantelId"] is Microsoft.AspNetCore.Mvc.Rendering.SelectList escuelas)
    {
        @* Solo se pregunta la escuela si la persona tiene más de una; si no, va la suya. *@
        if (escuelas.Count() > 1)
        {
            <div class="col-md-6">
                <label asp-for="PlantelId" class="form-label requerido">Escuela</label>
                <select asp-for="PlantelId" asp-items="escuelas" class="form-select"></select>
                <span asp-validation-for="PlantelId" class="text-danger small"></span>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="PlantelId" />
            <span asp-validation-for="PlantelId" class="text-danger small"></span>
        }
    }
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label requerido"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Apellidos" class="form-label requerido"></label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Parentesco" class="form-label requerido"></label>
        <select asp-for="Parentesco" class="form-select">
            <option>Madre</option>
            <option>Padre</option>
            <option>Abuela</option>
            <option>Abuelo</option>
            <option>Tía</option>
            <option>Tío</option>
            <option>Tutor legal</option>
        </select>
        <span asp-validation-for="Parentesco" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefono" class="form-label requerido"></label>
        <input asp-for="Telefono" class="form-control" inputmode="numeric" maxlength="10" placeholder="10 dígitos" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger small"></span>
    </div>
</div>
