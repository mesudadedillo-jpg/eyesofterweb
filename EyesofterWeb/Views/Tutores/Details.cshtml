@model Tutor
@{
    ViewData["Title"] = "Tutor";
    var esAdmin = User.IsInRole(Roles.Administrador);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.NombreCompleto</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
        <a asp-controller="Alumnos" asp-action="Create" asp-route-tutorId="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Vincular alumno</a>
        @if (esAdmin)
        {
            @if (!Model.Usuarios.Any())
            {
                <a asp-controller="Usuarios" asp-action="Crear" asp-route-tutorId="@Model.Id" class="btn btn-marca"><i class="bi bi-key me-1" aria-hidden="true"></i>Crear cuenta de acceso</a>
            }
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar</a>
        }
    </div>
</div>
<p class="small mb-3">
    @if (Model.Usuarios.Any())
    {
        <span class="text-success"><i class="bi bi-phone me-1" aria-hidden="true"></i>Tiene cuenta: @string.Join(", ", Model.Usuarios.Select(u => u.Email)) · recibe los avisos en la app y el portal.</span>
    }
    else
    {
        <span class="text-warning"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Sin cuenta de acceso: los avisos no le llegan; hay que llamarle por teléfono.</span>
    }
</p>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">@Html.DisplayNameFor(m => m.Parentesco)</dt><dd class="col-7">@Model.Parentesco</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.Telefono)</dt><dd class="col-7">@Model.Telefono</dd>
                    <dt class="col-5">@Html.DisplayNameFor(m => m.Correo)</dt><dd class="col-7">@(Model.Correo ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Alumnos a su cargo (@Model.Alumnos.Count)</h2>
                <a asp-controller="Alumnos" asp-action="Create" asp-route-tutorId="@Model.Id" class="btn btn-sm btn-marca"><i class="bi bi-plus-lg"></i> Agregar alumno</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (!Model.Alumnos.Any())
                {
                    <li class="list-group-item text-body-secondary">Sin alumnos registrados.</li>
                }
                @foreach (var a in Model.Alumnos.OrderBy(a => a.Nombre))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <a asp-controller="Alumnos" asp-action="Details" asp-route-id="@a.Id">@a.NombreCompleto</a>
                        <span class="text-body-secondary small">@a.GradoGrupo</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3 px-0"><i class="bi bi-arrow-left"></i> Volver a tutores</a>
