@model Tutor
@{
    ViewData["Title"] = "Editar tutor";
}

<h1 class="h3">Editar tutor</h1>
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-marca"><i class="bi bi-save me-1"></i>Guardar cambios</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
