@model IEnumerable<UsuarioListaItem>
@{
    ViewData["Title"] = "Usuarios y roles";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Usuarios y roles</h1>
        <p class="text-body-secondary mb-0">Solo el Administrador puede ver esta página y asignar roles.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.NombreCompleto</td>
                        <td>@u.Correo</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge text-bg-primary">@r</span>
                            }
                            @if (!u.Roles.Any())
                            {
                                <span class="badge text-bg-warning">Sin rol</span>
                            }
                        </td>
                        <td>
                            @if (u.Bloqueado)
                            {
                                <span class="badge text-bg-danger"><i class="bi bi-lock-fill me-1"></i>Bloqueado</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditarRol" asp-route-id="@u.Id"><i class="bi bi-person-gear me-1"></i>Cambiar rol</a>
                            @if (u.Bloqueado)
                            {
                                <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-unlock me-1"></i>Desbloquear</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
