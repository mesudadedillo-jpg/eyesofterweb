@model UsuarioFormViewModel
@{ ViewData["Title"] = Model.UsuarioId is null ? "Nueva cuenta" : "Editar cuenta"; }
<h1 class="h3">@ViewData["Title"]</h1>
<form asp-action="@(Model.UsuarioId is null ? "Crear" : "Editar")" method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input type="hidden" asp-for="UsuarioId" />
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="NombreCompleto" class="form-label requerido"></label><input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Correo" class="form-label requerido"></label><input asp-for="Correo" class="form-control" /><span asp-validation-for="Correo" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="Rol" class="form-label requerido"></label><select asp-for="Rol" asp-items="ViewBag.Roles" class="form-select"></select><span asp-validation-for="Rol" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="TutorId" class="form-label"></label><select asp-for="TutorId" asp-items="ViewBag.Tutores" class="form-select"><option value="">— (solo para Tutor)</option></select><span asp-validation-for="TutorId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="AlumnoId" class="form-label"></label><select asp-for="AlumnoId" asp-items="ViewBag.Alumnos" class="form-select"><option value="">— (solo para Alumno)</option></select><span asp-validation-for="AlumnoId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="ClinicaId" class="form-label"></label><select asp-for="ClinicaId" asp-items="ViewBag.Clinicas" class="form-select"><option value="">— (solo para Especialista)</option></select><span asp-validation-for="ClinicaId" class="text-danger small"></span></div>
    </div>
    @if (Model.UsuarioId is null) { <p class="small text-body-secondary mt-3 mb-0">La persona recibirá por correo un enlace para crear su contraseña. Nadie más la conoce.</p> }
    <div class="d-flex gap-2 mt-3"><button class="btn btn-marca">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
