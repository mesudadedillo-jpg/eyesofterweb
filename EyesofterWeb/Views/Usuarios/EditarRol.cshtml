@model EditarRolViewModel
@{
    ViewData["Title"] = "Cambiar rol";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4">Cambiar rol</h1>
                <p class="mb-4"><strong>@Model.NombreCompleto</strong><br /><span class="text-body-secondary">@Model.Correo</span></p>

                <form asp-action="EditarRol" method="post">
                    <div asp-validation-summary="All" class="text-danger small"></div>
                    <input type="hidden" asp-for="UsuarioId" />
                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" asp-items="ViewBag.Roles" class="form-select"></select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>
                    <ul class="small text-body-secondary">
                        <li><strong>Administrador:</strong> control total y asignación de roles.</li>
                        <li><strong>Enfermeria:</strong> registra y da seguimiento; no elimina ni administra catálogos.</li>
                        <li><strong>Docente:</strong> solo consulta.</li>
                    </ul>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-marca">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
