@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1"><i class="bi bi-person-plus text-marca me-1"></i>Crear cuenta</h1>
                <p class="text-body-secondary small mb-4">
                    Las cuentas nuevas inician con el rol <strong>Docente</strong> (solo consulta).
                    Un Administrador puede cambiar el rol después.
                </p>

                <form asp-action="Registro" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label requerido"></label>
                        <input asp-for="NombreCompleto" class="form-control" autocomplete="name" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label requerido"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label requerido"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmarPassword" class="form-label requerido"></label>
                            <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <p class="form-text">Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número.</p>
                    <button type="submit" class="btn btn-marca w-100">Crear cuenta</button>
                </form>

                <hr />
                <p class="small mb-0 text-center">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
