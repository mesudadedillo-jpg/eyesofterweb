@{
    ViewData["Title"] = "Acceso denegado";
    var ruta = ViewBag.ReturnUrl as string;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem" aria-hidden="true"></i>
                <h1 class="h3 mt-2">Acceso denegado (403)</h1>
                <p class="mb-3">Tu rol no tiene permiso para realizar esta acción.</p>
                <dl class="row text-start small bg-body-tertiary rounded p-3 mx-0">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8">@(User.Identity?.Name ?? "Sin sesión")</dd>
                    <dt class="col-sm-4">Rol(es)</dt>
                    <dd class="col-sm-8">
                        @{ var roles = Roles.Todos.Where(r => User.IsInRole(r)).ToList(); }
                        @(roles.Any() ? string.Join(", ", roles) : "Ninguno")
                    </dd>
                    @if (!string.IsNullOrEmpty(ruta))
                    {
                        <dt class="col-sm-4">Ruta solicitada</dt>
                        <dd class="col-sm-8"><code>@ruta</code></dd>
                    }
                </dl>
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-marca" asp-controller="Home" asp-action="Index">Ir al tablero</a>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Permisos">Ver permisos por rol</a>
                </div>
            </div>
        </div>
    </div>
</div>
