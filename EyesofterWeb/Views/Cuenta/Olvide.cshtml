@model OlvideViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1"><i class="bi bi-key text-marca me-1" aria-hidden="true"></i>Recuperar contraseña</h1>
                <p class="text-body-secondary small mb-4">Escribe tu correo y te enviaremos un enlace para crear una contraseña nueva.</p>
                <form asp-action="Olvide" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-marca w-100">Enviar enlace</button>
                </form>
                <p class="small mt-3 mb-0 text-center"><a asp-action="Login">Volver a iniciar sesión</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
