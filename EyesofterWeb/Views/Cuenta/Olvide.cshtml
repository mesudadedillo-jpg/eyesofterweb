@model OlvideViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1"><i class="bi bi-key text-marca me-1" aria-hidden="true"></i>Recuperar contraseña</h1>
                <p class="text-body-secondary small mb-4">Escribe el correo de tu cuenta o tu celular y te enviaremos un código de 6 dígitos para crear una contraseña nueva.</p>
                <form asp-action="Olvide" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Cuenta" class="form-label"></label>
                        <input asp-for="Cuenta" class="form-control" autocomplete="username" placeholder="tucorreo@ejemplo.com o 7751234567" />
                        <span asp-validation-for="Cuenta" class="text-danger small"></span>
                        <div class="form-text">El celular es el que la escuela tiene registrado del tutor.</div>
                    </div>
                    <button type="submit" class="btn btn-marca w-100">Enviar código</button>
                </form>
                <p class="small mt-3 mb-1 text-center"><a class="enlace-tactil" asp-action="IngresarCodigo">Ya tengo un código</a></p>
                <p class="small mb-0 text-center"><a class="enlace-tactil" asp-action="Login">Volver a iniciar sesión</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
