@model DosPasosViewModel
@{ ViewData["Title"] = "Activar verificación en dos pasos"; }
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-2"><i class="bi bi-shield-lock text-marca me-1" aria-hidden="true"></i>Verificación en dos pasos</h1>
        @if (Model.Obligatoria)
        {
            <div class="alert alert-info" role="status">
                Tu cuenta puede ver datos de salud de alumnos, así que la verificación en dos pasos es <strong>obligatoria</strong>.
                Así, aunque alguien conozca tu contraseña, no puede entrar sin tu teléfono.
            </div>
        }
        <div class="card shadow-sm">
            <div class="card-body">
                <ol class="mb-3">
                    <li class="mb-2">Instala en tu teléfono una app autenticadora: <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong> o Authy (son gratuitas).</li>
                    <li class="mb-2">En la app, elige «Agregar cuenta» y escanea este código:
                        <div class="my-2"><img src="@Model.QrDataUri" alt="Código QR para agregar EYESOFTER a tu app autenticadora" width="200" height="200" class="qr-img border rounded" style="max-width:100%" /></div>
                        <div class="small text-body-secondary">¿No puedes escanearlo? Escribe esta clave en la app: <code class="user-select-all">@Model.ClaveLegible</code></div>
                    </li>
                    <li>Escribe el código de 6 dígitos que te muestra la app:</li>
                </ol>
                <form asp-action="DosPasos" method="post" class="row g-2 align-items-start" novalidate>
                    <div class="col-sm-6">
                        <label asp-for="Codigo" class="visually-hidden"></label>
                        <input asp-for="Codigo" class="form-control form-control-lg text-center" autocomplete="one-time-code" inputmode="numeric" maxlength="7" placeholder="123456" />
                        <span asp-validation-for="Codigo" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6"><button class="btn btn-marca btn-lg w-100">Activar</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
