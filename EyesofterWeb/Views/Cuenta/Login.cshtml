@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1"><i class="bi bi-box-arrow-in-right text-marca me-1"></i>Iniciar sesión</h1>
                <p class="text-body-secondary small mb-4">Entra con tu cuenta de EYESOFTER Web.</p>

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="nombre@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-marca w-100">Entrar</button>
                </form>

                <hr />
                <p class="small mb-0 text-center">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>
            </div>
        </div>

        <div class="card mt-3 border-0 bg-body-tertiary">
            <div class="card-body small">
                <p class="fw-semibold mb-2"><i class="bi bi-info-circle me-1"></i>Cuentas de prueba</p>
                <ul class="mb-0 ps-3">
                    <li><code>admin@@eyesofter.mx</code> / <code>Admin123!</code> (Administrador)</li>
                    <li><code>enfermeria@@eyesofter.mx</code> / <code>Enfermeria123!</code> (Enfermería)</li>
                    <li><code>docente@@eyesofter.mx</code> / <code>Docente123!</code> (Docente)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
