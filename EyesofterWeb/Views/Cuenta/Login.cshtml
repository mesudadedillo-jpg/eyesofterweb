@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1"><i class="bi bi-box-arrow-in-right text-marca me-1" aria-hidden="true"></i>Iniciar sesión</h1>
                <p class="text-body-secondary small mb-4">Usa el mismo correo y contraseña que en la app EYESOFTER.</p>

                @if (ViewBag.Aviso is string aviso)
                {
                    <div class="alert alert-warning py-2" role="status"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>@aviso</div>
                }

                <form asp-action="Login" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="nombre@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-marca w-100">Entrar</button>
                </form>

                <hr />
                <p class="small mb-1 text-center"><a asp-action="Olvide">¿Olvidaste tu contraseña?</a></p>
                <p class="small mb-0 text-center text-body-secondary">¿No tienes cuenta? Pídela a la Dirección o a Enfermería de la escuela.</p>
            </div>
        </div>
        <p class="small text-center text-body-secondary mt-3 mb-0">
            Por seguridad, tras 3 intentos fallidos la cuenta se bloquea 15 minutos y la sesión se cierra sola después de 15 minutos sin actividad.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
