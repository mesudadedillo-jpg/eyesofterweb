@model CuentaGoogleViewModel
@{ ViewData["Title"] = "Iniciar sesión con Google"; }
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3"><i class="bi bi-google text-marca me-1" aria-hidden="true"></i>Iniciar sesión con Google</h1>
        <div class="card shadow-sm"><div class="card-body">
            @if (!Model.Disponible)
            {
                <p class="mb-0">El inicio de sesión con Google no está activado en este portal. Entra con tu correo y contraseña.</p>
            }
            else if (Model.Vinculada)
            {
                <p><i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>Tu cuenta ya está vinculada con Google. Puedes entrar con el botón <strong>Iniciar sesión con Google</strong>.</p>
                <p>Tu contraseña sigue funcionando en el portal y en la app.</p>
                <form asp-action="DesvincularGoogle" method="post">
                    <button type="submit" class="btn btn-outline-danger">Quitar el inicio de sesión con Google</button>
                </form>
            }
            else
            {
                <p>Entra al portal sin escribir tu contraseña, con tu cuenta de Google. Si la cuenta de Google tiene el mismo correo que la escuela registró (<strong>@Model.Correo</strong>), se vincula sola la primera vez que uses el botón en la página de inicio de sesión.</p>
                <p>¿Usas otra cuenta de Google? Vincúlala aquí:</p>
                <form asp-action="VincularGoogle" method="post">
                    <button type="submit" class="btn btn-google">
                        <partial name="_LogoGoogle" />
                        <span>Vincular mi cuenta de Google</span>
                    </button>
                </form>
            }
            <p class="small text-body-secondary mt-3 mb-0">
                Solo recibimos de Google tu nombre y tu correo; no vemos tus correos, archivos ni contactos.
                Cada vez que se vincula o se quita Google te avisamos a <strong>@Model.Correo</strong>.
                Si eres de Dirección o Enfermería, te seguiremos pidiendo el código de tu app autenticadora.
            </p>
        </div></div>
    </div>
</div>
