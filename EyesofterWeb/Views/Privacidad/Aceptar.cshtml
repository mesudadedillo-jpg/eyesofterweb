@{ ViewData["Title"] = "Tu consentimiento"; }
<div class="row justify-content-center"><div class="col-lg-9">
    <h1 class="h3">Antes de continuar</h1>
    <p>Para mostrarte la información de salud visual de tus hijos necesitamos que leas y aceptes el aviso de privacidad.</p>
    <div class="card card-body shadow-sm mb-3" style="max-height:28rem;overflow:auto" tabindex="0" aria-label="Texto del aviso de privacidad">
        <partial name="_TextoAviso" />
    </div>
    <form asp-action="Aceptar" method="post" class="card card-body shadow-sm">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="acepto" value="true" id="acepto" required />
            <label class="form-check-label" for="acepto">
                Leí el aviso de privacidad (versión @ViewBag.Version) y otorgo mi consentimiento expreso para el tratamiento de los datos personales y de salud de los menores a mi cargo con las finalidades descritas.
            </label>
        </div>
        <button type="submit" class="btn btn-marca">Aceptar y continuar</button>
    </form>
</div></div>
